{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "decorators": true,
            "syntax": "typescript"
          },
          "transform": {
            "decoratorMetadata": true,
            "legacyDecorator": true
          }
        },
        "module": {
          "type": "commonjs"
        }
      }
    ],
    "^.+\\.js$": [
      "@swc/jest",
      {
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "transformIgnorePatterns": []
}
