# ------------
# -- Server --
# ------------

# <required>
PORT=3001

# <optional>
TRUST_PROXY=

# <optional>
WEBSOCKET_ADAPTER=


# ------------
# -- Router --
# ------------

# <required>
ROUTER_BASE_URL=http://localhost:${PORT}

# -----------
# -- DEBUG --
# -----------

# <required>
DEBUG_PREFIX=app


# -------------
# -- MikroORM --
# -------------

# <required>
MIKRO_ORM_DATABASE_URL=postgresql://admin:admin@localhost:5432/scholark-portal-api

# <optional>
MIKRO_ORM_DEBUG=

# ---------
# -- Redis --
# ---------

# <required>
REDIS_HOST=localhost

# <required>
REDIS_PORT=6379

# <required>
AUTH_SESSION_SECRET=local-development-session-secret-change-me

# <required>
AUTH_JWT_SECRET=local-development-jwt-secret-change-me-now


# -----------
# -- Email --
# -----------

# <optional>
SMTP_USER=

# <optional>
SMTP_PASSWORD=

# <optional>
SMTP_HOST=

# <optional>
SMTP_PORT=

# <optional>
SMTP_SECURE=

# <optional>
SMTP_JSON_TRANSPORT=true


# ----------
# -- Auth --
# ----------

# <required>
AUTH_SESSION_COOKIE_NAME=scholark_session

# <required>
AUTH_SESSION_TTL_SECONDS=604800

# <optional>
AUTH_SESSION_REDIS_PREFIX=scholark:session:

# <required>
AUTH_TOKEN_TTL_SECONDS=86400

# <optional>
AUTH_COOKIE_SECURE=false

# <required>
# must have ":token" placeholder
AUTH_UPDATE_PASSWORD_URL=http://localhost:3000/auth/reset-password?token=:token

# <required>
AUTH_RESET_PASSWORD_EMAIL_FROM=no-reply@scholark.local

# <required>
AUTH_RESET_PASSWORD_EMAIL_SUBJECT="Reset your password"

# <required>
# must have ":token" placeholder
AUTH_CONFIRM_EMAIL_URL=http://localhost:3000/auth/confirm-email?token=:token

# <required>
AUTH_CONFIRM_EMAIL_FROM=no-reply@scholark.local

# <required>
AUTH_CONFIRM_EMAIL_SUBJECT="Confirm your email"


# -------------
# -- SWAGGER --
# -------------

# <optional>
SWAGGER_PERSIST_AUTHORIZATION=