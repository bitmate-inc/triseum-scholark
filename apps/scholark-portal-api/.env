# ------------
# -- Server --
# ------------

# <required>
PORT=3001

# <optional>
TRUST_PROXY=

# <optional>
CORS_ORIGIN=

# <optional>
WEBSOCKET_ADAPTER=


# ------------
# -- Router --
# ------------

# <required>
ROUTER_BASE_URL=http://localhost:${PORT}

WEBSITE_BASE_URL=http://localhost:3000

# -----------
# -- DEBUG --
# -----------

# <required>
DEBUG_PREFIX=app


# -------------
# -- MikroORM --
# -------------

# <required>
MIKRO_ORM_DATABASE_URL=postgresql://admin:admin@localhost:5432/scholark-portal-api

# <optional>
MIKRO_ORM_DEBUG=

# ---------
# -- Redis --
# ---------

# <required>
REDIS_URL=redis://localhost:6379

# ------------
# -- Stripe --
# ------------

# <required> Replace with a Stripe test-mode secret key for real checkout.
STRIPE_API_KEY=sk_test_local_development_placeholder

# <required>
STRIPE_PORTAL_URL=http://localhost:3000

# <required> Replace with the signing secret from `stripe listen` for webhooks.
STRIPE_WEBHOOK_SECRET=whsec_local_development_placeholder

# <optional>
STRIPE_CHECKOUT_CANCEL_URL=${WEBSITE_BASE_URL}/checkout/cancelled

# <optional>
STRIPE_CHECKOUT_SUCCESS_URL=${WEBSITE_BASE_URL}/checkout/success

# -----------
# -- Email --
# -----------

# <optional>
SMTP_USER=

# <optional>
SMTP_PASSWORD=

# <optional>
SMTP_HOST=

# <optional>
SMTP_PORT=

# <optional>
SMTP_SECURE=

# <optional>
SMTP_JSON_TRANSPORT=true


# ----------
# -- Auth --
# ----------

# <required>
AUTH_SESSION_SECRET=local-development-session-secret-change-me

# <required>
AUTH_JWT_SECRET=local-development-jwt-secret-change-me-now

# <required>
AUTH_SESSION_COOKIE_NAME=scholark_session

# <required>
AUTH_SESSION_TTL_SECONDS=604800

# <optional>
AUTH_SESSION_REDIS_PREFIX=scholark:session:

# <required>
AUTH_TOKEN_TTL_SECONDS=86400

# <optional>
AUTH_COOKIE_SECURE=false

# <optional>
AUTH_COOKIE_SAME_SITE=strict

# <required>
# must have ":token" placeholder
AUTH_UPDATE_PASSWORD_URL=${WEBSITE_BASE_URL}/auth/reset-password?token=:token

# <required>
AUTH_RESET_PASSWORD_EMAIL_FROM=no-reply@scholark.local

# <required>
AUTH_RESET_PASSWORD_EMAIL_SUBJECT="Reset your password"

# <required>
# must have ":token" placeholder
AUTH_CONFIRM_EMAIL_URL=${WEBSITE_BASE_URL}/auth/confirm-email?token=:token

# <required>
AUTH_CONFIRM_EMAIL_FROM=no-reply@scholark.local

# <required>
AUTH_CONFIRM_EMAIL_SUBJECT="Confirm your email"


# ----------------
# -- Game Proxy --
# ----------------

# <optional> Set a dedicated origin, or explicitly enable the local dev fallback.
GAME_PROXY_PUBLIC_ORIGIN=

# <optional> Explicit development-only opt-in when no dedicated game origin is available.
GAME_PROXY_ALLOW_SAME_ORIGIN_DEV=false

# <optional> Keep disabled unless an approved legacy/test game requires HTTP upstream.
GAME_PROXY_ALLOW_HTTP_UPSTREAM=false

# <optional>
GAME_PROXY_COOKIE_NAME=scholark_game

# <optional>
GAME_PROXY_TICKET_TTL_SECONDS=60

# <optional>
GAME_PROXY_SESSION_TTL_SECONDS=3600


# -------------
# -- SWAGGER --
# -------------

# <optional>
SWAGGER_PERSIST_AUTHORIZATION=