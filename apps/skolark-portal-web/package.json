{
  "name": "skolark-portal-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "generate:api": "rtk-query-codegen-openapi rtk-query.config.cjs && eslint --fix feature/api/client/api/generated-api.ts",
    "format": "pnpm run lint:fix",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@repo/ui": "workspace:*",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2"
  }
}
