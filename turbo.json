{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_SERVER_BASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
		".next/**", 
		"!.next/cache/**", 
		"!.next/dev/**", 
		"dist/**",
		"out/**"
	]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
	"lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
	  "dependsOn": [
        "^build"
      ]
    }
  }
}
